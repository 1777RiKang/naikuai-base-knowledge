{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1777RiKang/naikuai-base-knowledge/blob/main/schema/term.schema.json",
  "title": "奶块知识库词条",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "term",
    "canonical",
    "kind",
    "senses",
    "provenance",
    "contributors",
    "review",
    "version",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9-]+$"
    },
    "term": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "canonical": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "uniqueItems": true,
      "default": []
    },
    "kind": {
      "enum": [
        "item",
        "material",
        "consumable",
        "mount",
        "service",
        "jargon",
        "composite",
        "system"
      ]
    },
    "senses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context",
          "definition"
        ],
        "properties": {
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant_of": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "composes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "evidence"
      ],
      "properties": {
        "source": {
          "enum": [
            "community",
            "in-game"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "channel",
              "captured_at",
              "redacted"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 2,
                "maxLength": 200
              },
              "channel": {
                "enum": [
                  "公屏",
                  "群聊",
                  "游戏内实测",
                  "攻略站"
                ]
              },
              "captured_at": {
                "type": "string",
                "format": "date"
              },
              "redacted": {
                "type": "boolean"
              }
            }
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "github": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,39}$"
          },
          "role": {
            "enum": [
              "annotator",
              "reviewer",
              "maintainer"
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "confirmed",
            "disputed",
            "deprecated"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    }
  }
}
